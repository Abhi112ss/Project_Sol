# Project Sol — Local Infrastructure & Backend Environment Template
# Copy to infra/.env and backend/.env for local development. NEVER commit real secrets.

# PostgreSQL + PostGIS
POSTGRES_DB=transport_dev
POSTGRES_USER=sol_admin
POSTGRES_PASSWORD=sol_dev_pg_pass
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
DATABASE_URL=postgresql://sol_admin:sol_dev_pg_pass@127.0.0.1:5433/transport_dev

# Redis + BullMQ
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=sol_dev_redis_pass

# Central Transport Core (NestJS)
NODE_ENV=development
PORT=3001
API_PREFIX=api/v1
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
DEV_AUTH_BYPASS=true

# Zero-Budget Mapping Defaults
OSM_TILE_URL=https://tile.openstreetmap.org/{z}/{x}/{y}.png
OSM_USER_AGENT=ProjectSolETMS/0.1 (local-dev)
